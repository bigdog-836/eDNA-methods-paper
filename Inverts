##LM and Beta Mixed Model for proportions

# Prepare data by transforming and filtering proportions
# Use existing taxa_proportion from previous steps
if (!exists("taxa_proportion")) {
  stop("taxa_proportion not found in the session. Please run the earlier data prep steps.")
}

tp <- taxa_proportion %>% 
  mutate(prop = as.numeric(`proportion of ZOTUs at each site found by method`)) %>%
  filter(!is.na(prop)) %>%
  mutate(method = factor(method), site = factor(site))

print("Head of prepared data (tp):")
print(head(tp))

# Fit a linear mixed model: method as fixed, site as random
lmm_fit <- lmer(prop ~ method + (1|site), data = tp)
print("LMM summary:")
print(summary(lmm_fit))

# Perform ANOVA on the linear mixed model (type II via car not needed; default is fine)
print("ANOVA on LMM:")
print(anova(lmm_fit))

# EMMs and pairwise contrasts for the LMM
emm_lmm <- emmeans(lmm_fit, ~ method)
print("Estimated marginal means (LMM):")
print(emm_lmm)
print("Pairwise contrasts (LMM, Tukey-adjusted):")
print(pairs(emm_lmm, adjust = "tukey"))

# Transform proportions for beta regression
n_obs <- nrow(tp)
# Smithson & Verkuilen transformation
tp$prop_beta <- (tp$prop * (n_obs - 1) + 0.5) / n_obs
# Fallback clamp just in case
eps <- 1e-4
tp$prop_beta <- pmin(pmax(tp$prop_beta, eps), 1 - eps)

print("Head with beta-transformed proportion:")
print(head(tp[, c("site", "method", "prop", "prop_beta")]))

###Beta Mixed Model
# 1) Standardize column names (avoid backticks pain)
# taxa_proportion should have columns: sample, proportion of ZOTUs..., site, method
tp <- taxa_proportion %>%
  rename(prop = `proportion of ZOTUs at each site found by method`) %>%
  mutate(
    prop = as.numeric(prop),
    method = factor(method),
    site = factor(site)
  ) %>%
  filter(!is.na(prop))

# 2) Transform away from 0/1 for beta regression
# Smithson & Verkuilen style shrink toward (0,1)
n <- nrow(tp)
tp <- tp %>%
  mutate(prop_beta = (prop * (n - 1) + 0.5) / n)

# Quick sanity check
range(tp$prop, na.rm = TRUE)
range(tp$prop_beta, na.rm = TRUE)  # should be strictly between 0 and 1

# 3) Fit beta mixed model (site random intercept)
bmm_fit <- glmmTMB(
  prop_beta ~ method + (1 | site),
  family = beta_family(link = "logit"),
  data = tp
)

cat("\nBeta mixed model summary:\n")
print(summary(bmm_fit))

cat("\nANOVA (Type II Wald) for method:\n")
print(car::Anova(bmm_fit, type = 2))

# 4) Estimated marginal means on response scale + Tukey comparisons
emm_bmm <- emmeans(bmm_fit, ~ method, type = "response")

cat("\nEstimated marginal means (response scale):\n")
print(emm_bmm)

cat("\nPairwise comparisons (Tukey-adjusted, response scale):\n")
print(pairs(emm_bmm, adjust = "tukey"))

# 5) Plot EMMs with 95% CI on response scale
emm_df <- as.data.frame(emm_bmm)

p_bmm <- ggplot(emm_df, aes(x = method, y = response, ymin = asymp.LCL, ymax = asymp.UCL, fill = method)) +
  geom_col(alpha = 0.85, color = "grey20") +
  geom_errorbar(width = 0.15) +
  theme_minimal() +
  labs(
    title = "Mixed-effects beta regression: Estimated means by method",
    y = "Estimated proportion (mean)",
    x = "Method"
  ) +
  theme(legend.position = "none")

print(p_bmm)

library(DHARMa)
